# Public site URL (used for secure email confirmation redirects)
NEXT_PUBLIC_SITE_URL=https://tilbudjagt.dk

# Supabase (public URL and anon/publishable key may be exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never expose these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Affiliate network configuration (server-side only)
AWIN_PUBLISHER_ID=
AWIN_API_TOKEN=
# Website monetisation (public values; never put secrets here).
# Leave AdSense disabled until a Google-certified CMP is configured in AdSense.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_CMP_READY=false
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_STORES=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDES=
NEXT_PUBLIC_ADSENSE_SLOT_PRODUCTS=
NEXT_PUBLIC_ADSENSE_SLOT_STORE=
# Optional direct sponsor placement. It is labelled "Sponsoreret" automatically.
NEXT_PUBLIC_SPONSOR_NAME=
NEXT_PUBLIC_SPONSOR_URL=
NEXT_PUBLIC_SPONSOR_TEXT=
