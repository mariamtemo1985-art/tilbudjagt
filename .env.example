# Server-only secrets. Never expose these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Affiliate network configuration (server-side only)
AWIN_PUBLISHER_ID=
AWIN_API_TOKEN=
