# Supabase (create a project at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (configure products/prices and webhook before enabling checkout)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_VIP_PRICE_ID=

# AWIN (never expose private credentials in NEXT_PUBLIC variables)
AWIN_PUBLISHER_ID=
AWIN_API_TOKEN=

# Public site URL
NEXT_PUBLIC_SITE_URL=https://tilbudjagt.dk
